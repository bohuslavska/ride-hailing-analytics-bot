# Copy to .env and fill in. .env is git-ignored.

# --- database ---
# Owner role, used by the loader to create tables and copy data in.
DATABASE_URL=postgresql+psycopg://ride_hailing:ride_hailing@localhost:5434/ride_hailing

# Least-privilege role holding SELECT only. Every agent-generated query runs as
# this role, so a statement that slips past the SQL parser still cannot write.
READONLY_DATABASE_URL=postgresql+psycopg://ride_hailing_readonly:readonly_local@localhost:5434/ride_hailing

# --- guardrails on agent-generated SQL ---
SQL_STATEMENT_TIMEOUT_MS=15000
SQL_MAX_RETURNED_ROWS=500

# --- cache (optional) ---
# Deterministic analytics results (funnel, clustering, conversion, …). When unset
# or unreachable the app falls through to Postgres; chat still works.
REDIS_URL=redis://localhost:6381/0
REDIS_TTL_SECONDS=3600

# --- LLM ---
# OpenRouter is OpenAI-compatible. Without a key the REST analytics endpoints
# still work; only the chat assistant is disabled.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5
LLM_TEMPERATURE=0.0
AGENT_MAX_ITERATIONS=8
