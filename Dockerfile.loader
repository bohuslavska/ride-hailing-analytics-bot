# One-shot image: load local parquet into the Fly Postgres over the private
# network. Used when `fly proxy` / WireGuard is unavailable from the laptop.
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt pyarrow

COPY src ./src
COPY scripts ./scripts
COPY sql ./sql
COPY data ./data

# Load and exit. No HTTP server.
CMD ["python", "-m", "scripts.load_to_postgres"]
